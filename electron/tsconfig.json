{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "../dist-electron",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo"
  },
  "include": ["./**/*.ts", "./**/*.cts"],
  "exclude": ["node_modules"]
}
