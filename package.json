{
  "name": "schoolcare",
  "private": true,
  "version": "1.0.0",
  "description": "Application desktop SchoolCare",
  "author": "SchoolCare",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "start": "npm run dev",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('dist-electron',{recursive:true,force:true})\"",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -b && tsc -p electron/tsconfig.json --noEmit && tsc -p tests/tsconfig.json",
    "test": "npm run test:build && node scripts/run-tests.mjs",
    "test:build": "node -e \"require('node:fs').rmSync('test-dist',{recursive:true,force:true})\" && vite build --config vite.test.config.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "electron": "electron .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@react-pdf/renderer": "^4.9.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.51.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "daisyui": "^5.7.47",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^1.1.2"
  },
  "build": {
    "appId": "com.schoolcare.app",
    "productName": "SchoolCare",
    "directories": {
      "output": "release",
      "buildResources": "public"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraMetadata": {
      "main": "dist-electron/main.js"
    },
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icons.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon.iconset"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png",
      "category": "Education"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
